{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8081"
      ],
      "port": 8081
    },
    {
      "name": "mock-api",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/mock-api.js"
      ],
      "port": 8099
    },
    {
      "name": "mock-quota",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/mock-api.js"
      ],
      "port": 8099,
      "env": {
        "MOCK_MODE": "quota"
      }
    },
    {
      "name": "web-failover",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8082"
      ],
      "port": 8082,
      "env": {
        "EXPO_PUBLIC_APITUBE_API_KEY": "mock",
        "EXPO_PUBLIC_APITUBE_BASE_URL": "http://localhost:8099"
      }
    }
  ]
}