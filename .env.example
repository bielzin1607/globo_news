# Fonte principal (https://apitube.io). Copie este arquivo para .env e preencha.
EXPO_PUBLIC_APITUBE_API_KEY=

# Fontes alternativas gratuitas: usadas automaticamente quando a anterior estoura a cota.
# Todas opcionais (sem chave a fonte é pulada). O Google News (RSS) não precisa de chave.
# GNews: https://gnews.io
EXPO_PUBLIC_GNEWS_API_KEY=
# NewsData.io: https://newsdata.io
EXPO_PUBLIC_NEWSDATA_API_KEY=
# The News API: https://www.thenewsapi.com
EXPO_PUBLIC_THENEWSAPI_TOKEN=

# Ordem de tentativa (opcional)
# EXPO_PUBLIC_NEWS_PROVIDERS=apitube,gnews,newsdata,thenewsapi,googlenews
